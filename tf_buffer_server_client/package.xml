<?xml version="1.0"?>
<package format="3">
  <name>tf_buffer_server_client</name>
  <version>0.1.0</version>
  <description>C++ and Python clients for TF buffer server services.</description>
  <maintainer email="maik.knof@gmx.de">Maik Knof</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf_buffer_server_interfaces</depend>
  <depend>tf2_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rclpy</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclcpp_lifecycle</test_depend>
